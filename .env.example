# Application Environment
NODE_ENV=production

# Logging
LOG_LEVEL=info

# Backend Configuration
BACKEND_PORT=3000
BACKEND_HOST=localhost

# Frontend Configuration
FRONTEND_PORT=80

# API Configuration
REACT_APP_API_URL=http://localhost:3000

# Database Configuration (if needed)
DATABASE_URL=

# Security
JWT_SECRET=your-secret-key-here

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090
